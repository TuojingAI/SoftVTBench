# Benchmark checkout.
export SOFTVTBENCH_ROOT=/path/to/SoftVTBench

# Demonstrations and task assets are versioned separately from source code.
export SOFTVT_DATA_ROOT=/datasets/softvtbench/raw
export SOFTVT_ASSET_ROOT=/datasets/softvtbench/assets/USD
export SOFTVT_RIGID_STAGING_ROOT=/datasets/softvtbench/rigid_staging
export SOFTVT_SPATIAL_SOFT_STAGING_ROOT=/datasets/softvtbench/spatial_soft_staging

export SOFTVTBENCH_PYTHON=python
export SOFTVT_RESULT_ROOT=/path/to/results
